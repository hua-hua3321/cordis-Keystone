<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- 管理层/宿主嵌入形态（09）：把 Config + Runtime 串成可运行宿主 -->
    <RootNamespace>Keystone.Hosting</RootNamespace>
    <PackageId>Keystone.Hosting</PackageId>
    <Description>Keystone hosting layer: bootstrap, hosting API (CRUD/mount), management events.</Description>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Keystone.Hosting.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Keystone.Config\Keystone.Config.csproj" />
    <ProjectReference Include="..\Keystone.Runtime\Keystone.Runtime.csproj" />
  </ItemGroup>

  <!-- ADR-0018 L3 组合/导出层：OTel SDK 仅宿主可选接线（探针层纯 BCL，见 Runtime） -->
  <ItemGroup>
    <PackageReference Include="OpenTelemetry.Exporter.Console" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Meziantou.Analyzer">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
