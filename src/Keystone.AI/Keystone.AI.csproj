<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- AI 能力域适配器（ADR-0008 决策 1：单向依赖——仅本工程引用 MAF，核心绝不引用） -->
    <RootNamespace>Keystone.AI</RootNamespace>
    <PackageId>Keystone.AI</PackageId>
    <Description>Keystone AI capability adapters: MAF workflows bridge, SEP-2640 skills, MCP.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Keystone.Core\Keystone.Core.csproj" />
    <ProjectReference Include="..\Keystone.Runtime\Keystone.Runtime.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Agents.AI.Workflows" />
    <PackageReference Include="Microsoft.Agents.AI" />
    <PackageReference Include="Meziantou.Analyzer">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
