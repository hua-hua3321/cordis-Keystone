<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- 配置层：提供者抽象（IConfigurationSource）+ 默认 YAML/AgileConfig 提供者（ADR-0013） -->
    <RootNamespace>Keystone.Config</RootNamespace>
    <PackageId>Keystone.Config</PackageId>
    <Description>Keystone C# configuration layer: provider abstraction, YAML and AgileConfig providers.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Keystone.Core\Keystone.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="YamlDotNet" />
    <PackageReference Include="AgileConfig.Client" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Meziantou.Analyzer">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
