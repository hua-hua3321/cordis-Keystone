<Project>
  <!-- 工程级公共构建约束（P0 工程骨架）：标准 C# 14 / net10.0 / 规则 0 编译面 -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14.0</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- 杀常见错误于摇篮：警告即错误 + 全量 .NET 分析器 + 代码风格强制 -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest</AnalysisLevel>
    <AnalysisMode>Recommended</AnalysisMode>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisModeStyle>Recommended</AnalysisModeStyle>

    <!-- 可复现构建 + 依赖审计 -->
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>

    <!-- IDE0005（未使用 using）在构建期生效的前提 -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>

    <!-- 包引用集中管理（版本见 Directory.Packages.props） -->
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <!-- NuGet 包公共元数据（publish.yml 打 tag 时以 -p:Version 覆盖版本） -->
  <PropertyGroup>
    <Version>1.0.0</Version>
    <Authors>Keystone contributors</Authors>
    <Copyright>Copyright (c) 2026 Keystone contributors</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/hua-hua3321/cordis-Keystone</PackageProjectUrl>
    <RepositoryUrl>https://github.com/hua-hua3321/cordis-Keystone.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>plugin;plugin-framework;hot-reload;middleware;configuration;dotnet</PackageTags>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <!-- 仓库根 README 打入每个包（六工程均两级深） -->
  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" Condition="Exists('..\..\README.md')" />
  </ItemGroup>
</Project>
